{
  "name": "pootown",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.13.1 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @pootown/api build && pnpm --filter @pootown/api db:migrate",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm legacy:characterize && pnpm -r --if-present test",
    "test:web:vertical": "./scripts/run-web-vertical-test.sh",
    "test:contracts": "./scripts/run-release-gates.sh contracts",
    "test:e2e": "./scripts/run-release-gates.sh e2e",
    "test:reliability": "./scripts/run-release-gates.sh reliability",
    "test:security": "./scripts/run-release-gates.sh security",
    "test:restore": "./scripts/run-release-gates.sh restore",
    "test:load": "./scripts/run-release-gates.sh load",
    "release:gates": "./scripts/run-release-gates.sh all",
    "quality": "pnpm lint && pnpm test && pnpm build",
    "legacy:test": "anchor test",
    "legacy:characterize": "./scripts/run-legacy-characterization.sh",
    "lint:fix": "prettier \"{tests,scripts}/**/*.{js,ts,json,md}\" -w"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@magicblock-labs/ephemeral-validator": "0.13.20",
    "chai": "^4.3.4",
    "madge": "8.0.0",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
