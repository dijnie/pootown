{
  "name": "pootown",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.13.1 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @pootown/api build && pnpm --filter @pootown/api db:migrate",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter '!@pootown/load-tests' -r --if-present test",
    "test:web:vertical": "./scripts/run-web-vertical-test.sh",
    "test:contracts": "./scripts/run-release-gates.sh contracts",
    "test:e2e": "./scripts/run-release-gates.sh e2e",
    "test:reliability": "./scripts/run-release-gates.sh reliability",
    "test:security": "./scripts/run-release-gates.sh security",
    "test:restore": "./scripts/run-release-gates.sh restore",
    "test:load": "./scripts/run-release-gates.sh load",
    "images:verify": "./scripts/run-image-gates.sh",
    "images:scan": "./scripts/run-image-security-gates.sh",
    "containers:smoke": "./scripts/run-container-smoke.sh",
    "release:gates": "./scripts/run-release-gates.sh all",
    "quality": "pnpm lint && pnpm test && pnpm build",
    "lint:fix": "prettier \"{tests,scripts}/**/*.{js,ts,json,md}\" -w"
  },
  "devDependencies": {
    "madge": "8.0.0",
    "prettier": "^2.6.2",
    "typescript": "5.9.2"
  }
}
