# Solana RPC endpoints
NEXT_PUBLIC_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
NEXT_PUBLIC_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Default RPC (currently using devnet)
NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
# NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899

# WebSocket subscriptions
NEXT_PUBLIC_RPC_SUBSCRIPTIONS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Magicblock RPC
NEXT_PUBLIC_ER_RPC_URL=https://devnet.magicblock.app/
# NEXT_PUBLIC_ER_RPC_URL=https://devnet-router.magicblock.app/
NEXT_PUBLIC_ER_RPC_SUBSCRIPTIONS_URL=wss://devnet.magicblock.app/
# NEXT_PUBLIC_ER_RPC_SUBSCRIPTIONS_URL=wss://devnet-router.magicblock.app/

# Privy authentication
NEXT_PUBLIC_PRIVY_APP_ID=YOUR_PRIVY_APP_ID
PRIVY_APP_SECRET=YOUR_PRIVY_APP_SECRET
NEXT_PUBLIC_AUTH_ID_PRIVY=YOUR_AUTH_ID
NEXT_PUBLIC_AUTH_PRIVATE_KEY_PRIVY=YOUR_PRIVATE_KEY
PRIVY_AUTHORIZATION_SIGNATURE=YOUR_AUTH_SIGNATURE

# Local signaling server
NEXT_PUBLIC_SIGNALING_SERVER_URL=ws://localhost:3001
